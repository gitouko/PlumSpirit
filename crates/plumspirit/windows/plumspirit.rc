// Windows resources for PlumSpirit.exe: icon (the official PlumSpirit logo),
// version information and the application manifest.
#include <winver.h>

1 ICON "../../../assets/icon/plumspirit.ico"
1 24 "plumspirit.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,2,0
PRODUCTVERSION  1,0,2,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "PlumSpirit"
            VALUE "FileDescription",  "PlumSpirit - Black MIDI Editor (PlumSpirit v1.0.2)"
            VALUE "FileVersion",      "1.0.2"
            VALUE "InternalName",     "PlumSpirit"
            VALUE "OriginalFilename", "PlumSpirit.exe"
            VALUE "ProductName",      "PlumSpirit"
            VALUE "ProductVersion",   "1.0.2 (PlumSpirit v1.0.2)"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
